# Neon Postgres
# Use the pooled URL for app/runtime traffic.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/quotebuilder?sslmode=require&pgbouncer=true"

# Use the direct URL for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/quotebuilder?sslmode=require"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock authentication
MOCK_AUTH_EMAIL="owner@quotebuilder.pro"
MOCK_AUTH_NAME="Demo Owner"
