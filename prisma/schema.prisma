generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  calculators Calculator[]
  userPlans   UserPlan[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Calculator {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  name         String
  slug         String  @unique
  businessType String?
  description  String?
  isPublished  Boolean @default(false)
  isArchived   Boolean @default(false)

  questions    Question[]
  pricingRules PricingRule[]
  submissions  QuoteSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id                  String     @id @default(uuid())
  calculatorId        String
  calculator          Calculator @relation(fields: [calculatorId], references: [id])
  label               String
  questionType        String
  options             Json?
  visibilityCondition Json?
  sortOrder           Int        @default(0)
  isRequired          Boolean    @default(false)

  pricingRules PricingRule[]
}

model PricingRule {
  id           String     @id @default(uuid())
  calculatorId String
  calculator   Calculator @relation(fields: [calculatorId], references: [id])
  questionId   String?
  question     Question?  @relation(fields: [questionId], references: [id])
  ruleType     String
  ruleConfig   Json?
  amount       Decimal    @db.Decimal(18, 2)
  sortOrder    Int        @default(0)
}

model QuoteSubmission {
  id                          String     @id @default(uuid())
  calculatorId                String
  calculator                  Calculator @relation(fields: [calculatorId], references: [id])
  customerName                String
  customerEmail               String
  customerPhone               String?
  customerNotes               String?
  answers                     Json
  estimatedPrice              Decimal    @db.Decimal(18, 2)
  acceptedEstimateDisclaimer  Boolean    @default(false)
  acceptedLegalTerms          Boolean    @default(false)
  acceptedAt                  DateTime?
  status                      String     @default("NEW")
  createdAt                   DateTime   @default(now())
}

model Plan {
  id              String     @id @default(uuid())
  name            String
  monthlyPrice    Decimal    @db.Decimal(18, 2)
  calculatorLimit Int
  leadLimit       Int
  aiMonthlyLimit  Int?
  userPlans       UserPlan[]
}

model UserPlan {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id])
  status    String
  startedAt DateTime  @default(now())
  endsAt    DateTime?
}
