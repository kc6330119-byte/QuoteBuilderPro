generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use the pooled Neon endpoint (DATABASE_URL); migrations use the direct
  // unpooled endpoint (DIRECT_URL). See README "Neon and Prisma".
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(uuid())
  clerkUserId String?      @unique
  email       String       @unique
  name        String?
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id])
  calculators Calculator[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId, createdAt], name: "User_companyId_createdAt_idx")
}

model Company {
  id                           String       @id @default(uuid())
  name                         String
  slug                         String       @unique
  stripeCustomerId             String?      @unique
  stripeSubscriptionId         String?      @unique
  stripePriceId                String?
  planTier                     String       @default("FREE")
  subscriptionStatus           String       @default("NONE")
  subscriptionCurrentPeriodEnd DateTime?
  users                        User[]
  calculators                  Calculator[]
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
}

model Calculator {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  name         String
  slug         String
  publicId     String   @unique
  businessType String?
  description  String?
  brandName    String?
  brandLogoUrl String?
  brandColor   String?
  brandIntro   String?
  brandFooter  String?
  isPublished  Boolean  @default(false)
  isArchived   Boolean  @default(false)
  viewCount    Int      @default(0)

  questions    Question[]
  pricingRules PricingRule[]
  submissions  QuoteSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId], name: "Calculator_userId_idx")
  @@index([companyId, isArchived, updatedAt(sort: Desc)], name: "Calculator_company_archive_updated_idx")
  @@index([companyId, isPublished, isArchived], name: "Calculator_company_publish_archive_idx")
}

model Question {
  id                  String     @id @default(uuid())
  calculatorId        String
  calculator          Calculator @relation(fields: [calculatorId], references: [id])
  label               String
  questionType        String
  options             Json?
  visibilityCondition Json?
  sortOrder           Int        @default(0)
  isRequired          Boolean    @default(false)

  pricingRules PricingRule[]

  @@index([calculatorId, sortOrder], name: "Question_calculator_sort_idx")
}

model PricingRule {
  id           String     @id @default(uuid())
  calculatorId String
  calculator   Calculator @relation(fields: [calculatorId], references: [id])
  questionId   String?
  question     Question?  @relation(fields: [questionId], references: [id])
  ruleType     String
  ruleConfig   Json?
  amount       Decimal    @db.Decimal(18, 2)
  sortOrder    Int        @default(0)

  @@index([calculatorId, sortOrder], name: "PricingRule_calculator_sort_idx")
  @@index([questionId], name: "PricingRule_questionId_idx")
}

model QuoteSubmission {
  id                         String     @id @default(uuid())
  calculatorId               String
  calculator                 Calculator @relation(fields: [calculatorId], references: [id])
  customerName               String
  customerEmail              String
  customerPhone              String?
  customerNotes              String?
  answers                    Json
  estimatedPrice             Decimal    @db.Decimal(18, 2)
  acceptedEstimateDisclaimer Boolean    @default(false)
  acceptedLegalTerms         Boolean    @default(false)
  acceptedLegalVersion       String?
  acceptedAt                 DateTime?
  status                     String     @default("NEW")
  createdAt                  DateTime   @default(now())

  @@index([calculatorId, createdAt(sort: Desc)], name: "QuoteSubmission_calculator_created_idx")
}

// Idempotency ledger for Stripe webhook events — see app/api/stripe/webhook/route.ts.
model WebhookEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
